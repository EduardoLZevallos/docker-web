{
  "name": "docker-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:e2e": "npm run typecheck && VITE_E2E=true vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config=playwright.mock.config.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "cytoscape": "^3.35.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
